% =========================================================================
% FUNCIONES DE LOGICA DEL SISTEMA
% =========================================================================

function updateKernelText(btn, ~)
    fig = ancestor(btn,'figure');
    data = guidata(fig);
    modo = get(data.popup, 'Value');
    
    % Actualiza el texto en pantalla para que el usuario vea la matriz activa
    switch modo
        case 1
            str = {'[  0  -1   0 ]';'[ -1   4  -1 ]';'[  0  -1   0 ]'};
        case 2
            str = {'[ -2  -1   0 ]';'[ -1   1   1 ]';'[  0   1   2 ]'};
        case 3
            str = {'[ -1  -1  -1 ]';'[ -1   8  -1 ]';'[ -1  -1  -1 ]'};
    end
    set(data.kernelTxt, 'String', str);
end

function loadImage(btn, ~)
    fig = ancestor(btn,'figure');
    data = guidata(fig);
    [file,path] = uigetfile({'*.jpg;*.png;*.bmp;*.tif','Archivos de Imagen'});
    if isequal(file,0), return; end
    
    img = imread(fullfile(path,file));
    data.img = img;
    data.result = []; 
    data.edges = [];
    
    axes(data.ax1); imshow(img); title('Imagen Original');
    axes(data.ax2); cla; axis off; title('Procesada');
    guidata(fig,data);
end

function applyFilter(btn, ~)
    fig = ancestor(btn,'figure');
    data = guidata(fig);
    
    if isempty(data.img)
        errordlg('Error: Debe cargar una señal de entrada primero.', 'Falta Señal');
        return;
    end
    
    set(btn, 'Enable', 'off', 'String', 'Procesando...');
    drawnow;
    
    alpha = get(data.slider, 'Value');
    modo = get(data.popup, 'Value');
    img_dbl = double(data.img);
    
    % Selección de la matriz (Kernel) según la UI
    switch modo
        case 1 % Sharpening Clásico
            h = [0 -1 0; -1 4 -1; 0 -1 0];
            titulo = ['Realce (\alpha = ', num2str(alpha,2), ')'];
        case 2 % Relieve 3D
            h = [-2 -1 0; -1 1 1; 0 1 2];
            titulo = ['Relieve 3D (\alpha = ', num2str(alpha,2), ')'];
        case 3 % Bordes (Laplaciano 8 vecinos)
            h = [-1 -1 -1; -1 8 -1; -1 -1 -1];
            titulo = ['Bordes Puros (\alpha = ', num2str(alpha,2), ')'];
    end
    
    % Convolución Manual Universal
    [res, edges_raw] = convolucionUniversal(img_dbl, h, alpha, modo);
    
    data.edges = edges_raw;
    
    % Saturación segura de 8-bits
    res(res < 0) = 0;
    res(res > 255) = 255;
    data.result = uint8(res);
    
    axes(data.ax2); imshow(data.result); title(titulo);
    
    set(btn, 'Enable', 'on', 'String', '2. Procesar Señal');
    guidata(fig,data);
end

function showEdges(btn, ~)
    fig = ancestor(btn,'figure');
    data = guidata(fig);
    
    if isempty(data.edges)
        errordlg('Primero debe procesar la señal.', 'Error');
        return;
    end
    
    figure('Name', 'Visor de Matriz Resultante', 'NumberTitle', 'off');
    if size(data.edges, 3) == 3
        bordes_visuales = sum(data.edges, 3);
    else
        bordes_visuales = data.edges;
    end
    
    imshow(bordes_visuales, []);
    title('Matriz Pura extraída por el Kernel');
    colormap jet; colorbar; 
end

function downloadImage(btn, ~)
    fig = ancestor(btn,'figure');
    data = guidata(fig);
    
    if isempty(data.result)
        errordlg('No hay señal de salida para guardar.', 'Error');
        return;
    end
    
    [archivo, ruta] = uiputfile('*.png', 'Guardar señal exportada');
    if archivo ~= 0
        imwrite(data.result, fullfile(ruta, archivo));
        msgbox('¡Señal exportada con éxito!', 'Guardado');
    end
end

% =========================================================================
% MOTOR MATEMÁTICO UNIVERSAL DE CONVOLUCIÓN
% =========================================================================
function [out, edges_out] = convolucionUniversal(img, kernel, alpha, modo)
    [rows, cols, channels] = size(img);
    out = zeros(rows, cols, channels);
    edges_out = zeros(rows, cols, channels);
    
    % Zero-Padding para Sistema Estable
    img_pad = zeros(rows+2, cols+2, channels);
    img_pad(2:end-1, 2:end-1, :) = img;
    
    % Lazo de convolución LSI
    for ch = 1:channels
        for i = 2:rows+1
            for j = 2:cols+1
                ventana = img_pad(i-1:i+1, j-1:j+1, ch);
                
                % Producto escalar 2D
                conv_val = sum(sum(ventana .* kernel));
                edges_out(i-1, j-1, ch) = conv_val; 
                
                % Ecuación de Salida dependiente del modo
                if modo == 1
                    % Sharpening: Salida = Original + (Ganancia * Bordes)
                    out(i-1, j-1, ch) = img_pad(i,j,ch) + alpha * conv_val;
                elseif modo == 2
                    % Relieve 3D: Solo bordes + Desplazamiento DC (gris base 128)
                    out(i-1, j-1, ch) = (alpha * conv_val) + 128;
                elseif modo == 3
                    % Bordes Puros: Solo el kernel actuando
                    out(i-1, j-1, ch) = alpha * conv_val;
                end
            end
        end
    end
end
